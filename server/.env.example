# Copy this file to `server/.env` and fill in your credentials.
# Never commit `server/.env` with real secrets to Git (it is already in .gitignore).

# --- Real-Time Email Alerts via Resend (https://resend.com) ---
RESEND_API_KEY=
# Your personal email registered with Resend to receive portfolio contact notifications
CONTACT_NOTIFY_EMAIL=you@example.com
# Optional custom sender after verifying your own domain in Resend:
# RESEND_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# --- Admin API Protection (/api/messages, /api/stats, /api/links) ---
# Required to unlock admin endpoints via `Authorization: Bearer <secret>` or `X-Admin-Key`
ADMIN_SECRET=

# --- Turso Cloud libSQL Database (Stage 3 / Vercel Production) ---
# Leave blank locally to keep using server/portfolio.db (local SQLite fallback).
# In Vercel Project Settings -> Environment Variables, set both values from your Turso dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

